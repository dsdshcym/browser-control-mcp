{
  "manifest_version": 2,
  "name": "Browser Control CLI",
  "version": "1.5.0",
  "description": "Firefox extension that lets a local CLI perform actions on the browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-control-mcp@anthropic.com",
      "strict_min_version": "131.0"
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "history",
    "storage",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "options_ui": {
    "page": "options.html"
  }
}
